# Payment Service Environment Variables
# Copy this file to .env and fill in your actual values

# Stripe Configuration
# Get your secret key from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Optional: Override default URLs (if not using application.properties)
# PAYMENT_SUCCESS_URL=http://localhost:5173/payment/success
# PAYMENT_CANCEL_URL=http://localhost:5173/payment/cancel
